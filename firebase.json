{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "functions": {
        "source": "functions"
    },
    "emulators": {
        "firestore": {
            "host": "127.0.0.1",
            "port": 8080
        },
        "storage": {
            "host": "127.0.0.1",
            "port": 9199
        }
    },
    "hosting": [
        {
            "target": "landing",
            "public": "landing",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "/invite",
                    "destination": "/index.html"
                },
                {
                    "source": "/profile/**",
                    "destination": "/index.html"
                },
                {
                    "source": "/privacy-policy",
                    "destination": "/privacy-policy.html"
                },
                {
                    "source": "/terms-of-service",
                    "destination": "/terms-of-service.html"
                },
                {
                    "source": "/liquidity_treasury",
                    "destination": "/liquidity_treasury.html"
                },
                {
                    "source": "/investors_saft",
                    "destination": "/liquidity_treasury.html"
                },
                {
                    "source": "/whitepaper",
                    "destination": "/whitepaper.html"
                },
                {
                    "source": "/v2",
                    "destination": "/index_v2.html"
                },
                {
                    "source": "/index_v2",
                    "destination": "/index_v2.html"
                }
            ],
            "headers": [
                {
                    "source": "**",
                    "headers": [
                        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
                        { "key": "X-Content-Type-Options", "value": "nosniff" },
                        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), payment=(self)" },
                        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; connect-src 'self' https: wss:; img-src 'self' data: blob: https:; font-src 'self' data: https:; media-src 'self' blob: https:; frame-src https://js.stripe.com https://hooks.stripe.com; worker-src 'self' blob:" }
                    ]
                },
                {
                    "source": "**/*.html",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        }
                    ]
                },
                {
                    "source": "**/*.@(css|js)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=3600, must-revalidate"
                        }
                    ]
                },
                {
                    "source": "**/*.apk",
                    "headers": [
                        {
                            "key": "Content-Type",
                            "value": "application/vnd.android.package-archive"
                        },
                        {
                            "key": "Content-Disposition",
                            "value": "attachment; filename=\"diaspora-nearby.apk\""
                        },
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        }
                    ]
                }
            ]
        },
        {
            "target": "app",
            "public": "app_deploy",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "headers": [
                {
                    "source": "**",
                    "headers": [
                        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
                        { "key": "X-Content-Type-Options", "value": "nosniff" },
                        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), payment=(self)" },
                        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; connect-src 'self' https: wss:; img-src 'self' data: blob: https:; font-src 'self' data: https:; media-src 'self' blob: https:; frame-src https://js.stripe.com https://hooks.stripe.com; worker-src 'self' blob:" }
                    ]
                },
                {
                    "source": "/.well-known/apple-app-site-association",
                    "headers": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                {
                    "source": "/.well-known/assetlinks.json",
                    "headers": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                }
            ]
        }
    ],
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "diaspora-nearby-a3dac",
                    "appId": "1:512074182214:android:3a55dd7ec6825f2db92447",
                    "fileOutput": "android/app/google-services.json"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "projectId": "diaspora-nearby-a3dac",
                    "configurations": {
                        "android": "1:512074182214:android:3a55dd7ec6825f2db92447",
                        "ios": "1:512074182214:ios:60cf4efcfcb7d872b92447",
                        "web": "1:512074182214:web:351bd07f62180977b92447"
                    }
                }
            }
        }
    }
}
