# ==============================================================================
# DIASPORA NEARBY — Firebase Cloud Functions Environment (PUBLIC CONFIG ONLY)
# ==============================================================================
# Copy this file to `functions/.env` for local dev. Production uses these same
# values (they're public). DO NOT put secrets in here — secrets live in
# Google Secret Manager and are mounted into process.env at function runtime
# via `.runWith({ secrets: [...] })` in the function declaration.
#
# To set/rotate a secret:
#   firebase functions:secrets:set SECRET_NAME
# To inspect:
#   firebase functions:secrets:access SECRET_NAME
#
# Secrets managed in Secret Manager (not in this file):
#   - BACKEND_SIGNER_PRIVATE_KEY  (TGE oracle / wallet ops signer)
#   - AMADEUS_API_KEY             (travel API)
#   - AMADEUS_API_SECRET          (travel API)
#   - STRIPE_SECRET_KEY           (set when going live with Stripe)

# ── Public on-chain addresses (Base Mainnet) ──
TOKEN_ADDRESS=0x55d7e7d006938A15082752225ED44Fd130B87735
TGE_CONTROLLER_ADDRESS=0xb6C049D47A2FaE5413c331760C22E715D0bF4d45
WALLET_FACTORY_ADDRESS=0x9cF797cf332595c00410fc4ee9FdEe5C59501945

# ── System treasury wallet overrides (OPTIONAL) ──
# performTGE() reads the wallet for each system slot (founders / liquidity /
# investors / burn) from its governance/<id>.walletAddress doc by default.
# Set these env vars only if you want to repoint a slot without editing
# Firestore — e.g. migrating to the CREATE2 treasury wallets from
# blockchain/treasury-output.txt:
#   FOUNDERS_TREASURY_ADDRESS=0xda9073CbA407648d5EB3271F6B18CEbBd1290D3F
#   LIQUIDITY_TREASURY_ADDRESS=0x3c788A75744589CAC7371dfe1bf64DB1047048d5

# ── Public RPC ──
RPC_URL=https://mainnet.base.org
