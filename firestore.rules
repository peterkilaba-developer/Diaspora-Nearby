rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    // Null-safe helpers (in CEL, map.get(key, default) returns null if key is present with value null!)
    function listOrEmpty(data, key) {
      return data.get(key, []) is list ? data.get(key, []) : [];
    }
    function mapOrEmpty(data, key) {
      return data.get(key, {}) is map ? data.get(key, {}) : {};
    }
    function intOrDefault(data, key, defaultVal) {
      return data.get(key, defaultVal) is number ? data.get(key, defaultVal) : defaultVal;
    }
    function boolOrDefault(data, key, defaultVal) {
      return data.get(key, defaultVal) is bool ? data.get(key, defaultVal) : defaultVal;
    }
    function stringOrDefault(data, key, defaultVal) {
      return data.get(key, defaultVal) is string ? data.get(key, defaultVal) : defaultVal;
    }
    function onlySelfListChange(before, after) {
      let b = before is list ? before : [];
      let a = after is list ? after : [];
      return a.hasOnly(b.concat([request.auth.uid])) &&
        b.hasOnly(a.concat([request.auth.uid]));
    }
    function validLastMessageChange(before, after) {
      let changed = after.diff(before).affectedKeys();
      let previousMessage = mapOrEmpty(before, 'lastMessage');
      let nextMessage = mapOrEmpty(after, 'lastMessage');
      return !changed.hasAny(['lastMessage']) ||
        (
          nextMessage is map && previousMessage is map &&
          nextMessage.diff(previousMessage).affectedKeys().hasOnly(['status']) &&
          stringOrDefault(nextMessage, 'status', '') in ['sent', 'delivered', 'read']
        ) ||
        (
          nextMessage is map && previousMessage is map &&
          nextMessage.diff(previousMessage).affectedKeys().hasOnly(['content', 'type']) &&
          stringOrDefault(nextMessage, 'type', '') == 'deleted'
        ) ||
        (
          nextMessage is map &&
          stringOrDefault(nextMessage, 'senderId', '') == request.auth.uid &&
          stringOrDefault(nextMessage, 'content', '').size() <= 20000 &&
          stringOrDefault(nextMessage, 'type', '').size() <= 64
        ) ||
        (
          nextMessage is map &&
          stringOrDefault(nextMessage, 'type', '') == 'system' &&
          stringOrDefault(nextMessage, 'content', '').size() <= 500
        );
    }
    // Check if the current user is a system admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }
    // Check if user is a participant of a chat (used by message subcollection rules)
    function isChatParticipant(chatId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/userChats/$(chatId)) ||
        (
          exists(/databases/$(database)/documents/chats/$(chatId)) &&
          (
            listOrEmpty(get(/databases/$(database)/documents/chats/$(chatId)).data, 'participants').hasAny([request.auth.uid]) ||
            stringOrDefault(get(/databases/$(database)/documents/chats/$(chatId)).data, 'type', '') == 'community' ||
            boolOrDefault(get(/databases/$(database)/documents/chats/$(chatId)).data, 'isPublic', false) == true
          )
        )
      );
    }
    function isDirectChat(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)) &&
        stringOrDefault(get(/databases/$(database)/documents/chats/$(chatId)).data, 'type', '') == 'direct';
    }
    function hasDirectChatBlock(chatId) {
      let participants = listOrEmpty(get(/databases/$(database)/documents/chats/$(chatId)).data, 'participants');
      return isDirectChat(chatId) &&
        participants.size() == 2 && (
          exists(/databases/$(database)/documents/user_blocks/$(request.auth.uid)/blocked/$(participants[0])) ||
          exists(/databases/$(database)/documents/user_blocks/$(request.auth.uid)/blocked/$(participants[1])) ||
          exists(/databases/$(database)/documents/user_blocks/$(participants[0])/blocked/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/user_blocks/$(participants[1])/blocked/$(request.auth.uid))
        );
    }
    // Check if user is an admin of the organization (requires reading the org doc)
    function isOrgAdmin(orgId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        listOrEmpty(get(/databases/$(database)/documents/organizations/$(orgId)).data, 'admins').hasAny([request.auth.uid]);
    }
    // Is this chat doc a corridor-chamber chat?
    function isChamberChat(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)) &&
        stringOrDefault(get(/databases/$(database)/documents/chats/$(chatId)).data, 'subtype', '') == 'corridor_chamber';
    }
    // Does the current user hold full-member access to a chamber chat?
    // Followers have `accessLevel: 'follower'`; members have `accessLevel: 'member'`.
    function isChamberMember(chatId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/userChats/$(chatId)) &&
        stringOrDefault(get(/databases/$(database)/documents/users/$(request.auth.uid)/userChats/$(chatId)).data, 'accessLevel', '') == 'member';
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Security-sensitive attributes are server-owned. In particular, a
      // profile document must never be able to grant its owner admin rights
      // or manufacture trust/economic milestones.
      allow create: if isAuthenticated() && isOwner(userId) &&
        !request.resource.data.keys().hasAny([
          'isAdmin', 'admin', 'roles', 'customClaims',
          'trustScore', 'trustLevel', 'isIdentityVerified',
          'blockedByCount', 'vouchedByCount',
          'walletAddress', 'smartWalletAddress', 'welcomeBonusAwarded',
          'advertReportCount', 'flaggedMessagesCount', 'isBanned',
          'bannedAt', 'bannedReason', 'firstQrConnection',
          'phone', 'dateOfBirth', 'geo', 'workLocation', 'pastLocations',
          'fcmToken', 'fcmTokenUpdatedAt', 'fcmTopics',
          'fcmTopicsUpdatedAt', 'notificationsEnabled', 'blockedUsers'
        ]) &&
        !mapOrEmpty(request.resource.data, 'homeLocation').keys().hasAny([
          'place_id'
        ]) &&
        !mapOrEmpty(request.resource.data, 'hostLocation').keys().hasAny([
          'place_id'
        ]) &&
        stringOrDefault(mapOrEmpty(request.resource.data, 'currentLocation'), 'place_id', '') == '' &&
        boolOrDefault(request.resource.data, 'cityVisibilityForfeited', false) == false &&
        boolOrDefault(mapOrEmpty(request.resource.data, 'businessProfile'), 'isBusinessVerified', false) == false;
      allow update: if isAdmin() || (
        isAuthenticated() && isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isAdmin', 'admin', 'roles', 'customClaims',
          'trustScore', 'trustLevel', 'isIdentityVerified',
          'blockedByCount', 'vouchedByCount',
          'walletAddress', 'smartWalletAddress', 'welcomeBonusAwarded',
          'advertReportCount', 'flaggedMessagesCount', 'isBanned',
          'bannedAt', 'bannedReason', 'firstQrConnection',
          'phone', 'dateOfBirth', 'geo', 'workLocation', 'pastLocations',
          'fcmToken', 'fcmTokenUpdatedAt', 'fcmTopics',
          'fcmTopicsUpdatedAt', 'notificationsEnabled', 'blockedUsers'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['homeLocation']) ||
          !mapOrEmpty(request.resource.data, 'homeLocation').keys().hasAny(['place_id'])
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostLocation']) ||
          !mapOrEmpty(request.resource.data, 'hostLocation').keys().hasAny(['place_id'])
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentLocation']) ||
          stringOrDefault(mapOrEmpty(request.resource.data, 'currentLocation'), 'place_id', '') == ''
        ) &&
        (
          boolOrDefault(resource.data, 'cityVisibilityForfeited', false) == false ||
          boolOrDefault(request.resource.data, 'cityVisibilityForfeited', false) == true
        ) &&
        boolOrDefault(mapOrEmpty(request.resource.data, 'businessProfile'), 'isBusinessVerified', false) ==
          boolOrDefault(mapOrEmpty(resource.data, 'businessProfile'), 'isBusinessVerified', false)
      );
      allow delete: if isAdmin();
      
      // Relationships Subcollection
      match /relationships/{relationshipId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if false;
      }

      match /relationship_slots/{slotId} {
        allow read, write: if false;
      }

      // Notifications Subcollection
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if isAuthenticated() && isOwner(userId);
      }

      // Saved Marketplace Listings Subcollection
      match /saved_listings/{listingId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Owner-only PII and precise location. Cloud Functions can read this via
    // Admin SDK for notifications and proximity matching.
    match /user_private/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) &&
        !request.resource.data.keys().hasAny(['blockedUsers']);
      allow update: if isAuthenticated() && isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['blockedUsers']);
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Relationship Requests Collection
    match /relationship_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.toUserId == request.auth.uid || 
        resource.data.fromUserId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /user_blocks/{blockerId} {
      allow read, write: if false;
      match /blocked/{blockedId} {
        allow read, write: if false;
      }
    }

    match /direct_chat_pairs/{pairId} {
      allow read, write: if false;
    }
    
    // --- Chats Collection ---
    match /chats/{chatId} {
      allow read: if isChatParticipant(chatId);
      // Membership and reserved routing metadata are canonical server state.
      // All chat types, including ordinary groups, are created by createChat
      // or another purpose-specific backend transaction.
      allow create: if false;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isChatParticipant(chatId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'lastMessage', 'updatedAt', 'lastActivityAt', 'type'
           ]) &&
           (
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['type']) ||
             stringOrDefault(request.resource.data, 'type', '') == stringOrDefault(resource.data, 'type', '') ||
             stringOrDefault(request.resource.data, 'type', '') in ['direct', 'community', 'event', 'organization', 'group']
           ) &&
           validLastMessageChange(resource.data, request.resource.data)
        )
      );
      allow delete: if isAdmin();

      // Messages subcollection — participants only
      // [SECURITY] Only chat participants can read/write messages
      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        // Post-rights gating:
        //   * Non-chamber chats: any participant (legacy rule).
        //   * Chamber chats: participants who are MEMBERS (accessLevel ==
        //     'member' on their userChats entry). Followers are participants
        //     for read purposes but cannot post.
        allow create: if isChatParticipant(chatId) &&
          !hasDirectChatBlock(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasOnly([
            'id', 'chatId', 'senderId', 'senderName', 'senderImage',
            'senderHostCountryCode', 'senderHomeCountryCode', 'content', 'text',
            'type', 'timestamp', 'status', 'mentions', 'richContent',
            'metadata', 'replyTo', 'adminId', 'adminImage', 'imageUrl',
            'documentUrl', 'documentName', 'documentSize', 'audioDuration',
            'storagePath', 'location', 'forwarded', 'originalSenderId',
            'originalSenderName', 'originalSenderImage',
            'originalSenderHostCountryCode', 'originalSenderHomeCountryCode',
            'originalTimestamp', 'deletedFor', 'deletedForEveryone',
            'isEdited', 'editedAt'
          ]) &&
          stringOrDefault(request.resource.data, 'content', '').size() <= 20000 &&
          (!isChamberChat(chatId) || isChamberMember(chatId));
        // Sender can edit content/status/delete-for-everyone.
        // Any participant can update status (read receipts) or delete-for-me (deletedFor).
        allow update: if isChatParticipant(chatId) && (
          (
            resource.data.senderId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'content', 'text', 'type', 'isEdited', 'editedAt', 'isDeleted',
              'deletedAt', 'deletedFor', 'deletedForEveryone', 'status'
            ])
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'deletedFor']) &&
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedFor']) ||
              onlySelfListChange(
                listOrEmpty(resource.data, 'deletedFor'),
                listOrEmpty(request.resource.data, 'deletedFor')
              )
            )
          )
        );
        // Messages should not be hard-deleted (use soft-delete flag instead)
        allow delete: if isAdmin();
      }

      // Typing indicators subcollection
      match /typing/{typingUserId} {
        allow read: if isChatParticipant(chatId);
        allow write: if isChatParticipant(chatId) && isOwner(typingUserId);
      }
    }

    // --- User Chats Subcollection (under users) ---
    // Only the owner may mutate their client-side index. Cross-user fan-out is
    // performed by Cloud Functions using the Admin SDK.
    match /users/{userId}/userChats/{chatId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) &&
        stringOrDefault(request.resource.data, 'chatId', chatId) == chatId &&
        !request.resource.data.keys().hasAny([
          'lastDeliveredMessageId', 'invitationOnly'
        ]) &&
        (
          !request.resource.data.keys().hasAny(['accessLevel']) ||
          stringOrDefault(request.resource.data, 'accessLevel', '') in ['follower', 'member']
        );
      allow update: if isAuthenticated() && isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'lastDeliveredMessageId', 'invitationOnly'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accessLevel']) ||
          stringOrDefault(request.resource.data, 'accessLevel', '') in ['follower', 'member']
        );
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // --- Discoverable Chats Collection ---
    match /discoverableChats/{chatId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }
    
    // --- Communities Collection ---
    // Public read for global_community (landing page epoch card)
    match /communities/global_community {
      allow read: if true;
      allow write: if false;
    }
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          listOrEmpty(resource.data, 'admins').hasAny([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name', 'description', 'profileImage', 'flag', 'images',
              'isPrivate', 'updatedAt'
            ])
        )
      );
      allow delete: if isAdmin();

      // Treasury sub-collection
      // [SECURITY] Only Cloud Functions (admin SDK) can modify treasury data
      match /treasury/{document=**} {
        allow read: if isAuthenticated();
        allow write: if false; // Cloud Functions admin SDK ONLY
      }

      // Members sub-collection (fallback for getCommunityMemberIds)
      // [SECURITY] Users can only add/remove themselves
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }
    
    // --- Events Collection ---
    match /events/{eventId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid &&
        listOrEmpty(request.resource.data, 'attendees').hasOnly([request.auth.uid]) &&
        listOrEmpty(request.resource.data, 'attendees').size() <= 1 &&
        intOrDefault(request.resource.data, 'attendeeCount', 0) ==
          listOrEmpty(request.resource.data, 'attendees').size() &&
        listOrEmpty(request.resource.data, 'interested').size() == 0 &&
        intOrDefault(request.resource.data, 'interestedCount', 0) == 0 &&
        listOrEmpty(request.resource.data, 'paidAttendeeIds').size() == 0 &&
        listOrEmpty(request.resource.data, 'confirmedAttendees').size() == 0 &&
        listOrEmpty(request.resource.data, 'invitedUserIds').size() <= 100 &&
        boolOrDefault(request.resource.data, 'isPaid', false) == false &&
        intOrDefault(request.resource.data, 'maxAttendees', 5000) > 0 &&
        intOrDefault(request.resource.data, 'maxAttendees', 5000) <= 5000;
      
      allow update: if isAuthenticated() && (
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'attendees', 'attendeeCount', 'interested', 'interestedCount',
            'paidAttendeeIds', 'confirmedAttendees'
          ]) && (
            resource.data.creatorId == request.auth.uid ||
            (resource.data.get('organizationId', null) != null && isOrgAdmin(resource.data.organizationId)) ||
            isAdmin()
          ) && request.resource.data.creatorId == resource.data.creatorId &&
            listOrEmpty(request.resource.data, 'invitedUserIds').size() <= 100 &&
            boolOrDefault(request.resource.data, 'isPaid', false) == boolOrDefault(resource.data, 'isPaid', false) &&
            intOrDefault(request.resource.data, 'maxAttendees', 5000) > 0 &&
            intOrDefault(request.resource.data, 'maxAttendees', 5000) <= 5000
        ) || (
          // Allow an RSVP'd attendee to record geofenced attendance confirmation for themselves
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedAttendees']) &&
          listOrEmpty(resource.data, 'attendees').hasAny([request.auth.uid]) &&
          onlySelfListChange(
            listOrEmpty(resource.data, 'confirmedAttendees'),
            listOrEmpty(request.resource.data, 'confirmedAttendees')
          )
        )
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        (resource.data.get('organizationId', null) != null && isOrgAdmin(resource.data.organizationId)) ||
        isAdmin()
      );
      
       // Subcollections (attendees, etc.)
       // [SECURITY] Only event creator or users adding/removing themselves
       match /attendees/{attendeeId} {
          allow read: if isAuthenticated();
          allow write: if false;
       }
       match /{subcollection}/{docId} {
          allow read: if isAuthenticated();
          allow write: if false;
       }
    }
    
    // --- Organizations Collection ---
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.superAdminId == request.auth.uid &&
        listOrEmpty(request.resource.data, 'admins').hasOnly([request.auth.uid]) &&
        stringOrDefault(request.resource.data, 'kind', '') != 'corridor_chamber' &&
        listOrEmpty(request.resource.data, 'members').hasOnly([request.auth.uid]) &&
        !request.resource.data.keys().hasAny([
          'gdpTotal', 'gdpByActivityType', 'gdpByDirection',
          'transactionCount', 'lastTransactionAt', 'treasuryBalance',
          'awardedBalance', 'memberPoints', 'points', 'averagePoCT',
          'walletAddress', 'smartWalletAddress'
        ]);
      // [SECURITY] Corridor chambers (kind == 'corridor_chamber') are
      // system-managed. Only platform admins may rewrite leadership /
      // membership fields directly; everyone else may only touch
      // `followers` / `members` (to follow/unfollow/join/leave). All other orgs
      // follow the original rule (org-admin can update, anyone can self-add to
      // followers).
      allow update: if (
        // Chambers — platform admins only for substantive edits.
        stringOrDefault(resource.data, 'kind', '') == 'corridor_chamber' && (
          isAdmin() ||
          // Non-admins can only self-modify membership / follow status.
          // arrayUnion / arrayRemove of their own uid in members/followers
          // and the bookkeeping fields are allowed.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['members', 'followers', 'memberCount', 'updatedAt']
          ) &&
          onlySelfListChange(
            listOrEmpty(resource.data, 'members'),
            listOrEmpty(request.resource.data, 'members')
          ) &&
          onlySelfListChange(
            listOrEmpty(resource.data, 'followers'),
            listOrEmpty(request.resource.data, 'followers')
          ) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberCount']) ||
            intOrDefault(request.resource.data, 'memberCount', 0) ==
              listOrEmpty(request.resource.data, 'members').size()
          )
        )
      ) || (
        // Regular orgs — original rule.
        stringOrDefault(resource.data, 'kind', '') != 'corridor_chamber' && (
          (
            (isOrgAdmin(orgId) || isAdmin()) &&
            stringOrDefault(request.resource.data, 'kind', '') ==
              stringOrDefault(resource.data, 'kind', '') &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'gdpTotal', 'gdpByActivityType', 'gdpByDirection',
              'transactionCount', 'lastTransactionAt', 'treasuryBalance',
              'awardedBalance', 'memberPoints', 'points', 'averagePoCT',
              'walletAddress', 'smartWalletAddress'
            ])
          ) || (
            isAuthenticated() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'updatedAt']) &&
            onlySelfListChange(
              listOrEmpty(resource.data, 'followers'),
              listOrEmpty(request.resource.data, 'followers')
            )
          )
        )
      );
      allow delete: if isAdmin() || isOrgAdmin(orgId);

      // Products/Services subcollection
      // [SECURITY] Only org admins can create/modify products
      match /products/{productId} {
        allow read: if isAuthenticated();
        allow write: if isOrgAdmin(orgId) || isAdmin();
      }
    }

    // --- Chamber Leadership Requests ---
    // A user submits a request to be appointed to a chamber leadership seat.
    // An admin flips `approved: true`, which triggers the
    // onChamberLeadershipRequestApproved Cloud Function to perform the
    // actual appointment server-side.
    match /leadershipRequests/{requestId} {
      allow read: if isAuthenticated();

      // Users submit their OWN pending request, never pre-approved.
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.approved == false
        && request.resource.data.status == 'pending';

      // Only platform admins can flip the approved boolean or set status.
      // Users can withdraw their own pending request by deleting it
      // (see the delete rule below) — they cannot edit a request once
      // submitted to prevent role-shopping after the fact.
      allow update: if isAdmin();

      // Self-withdrawal of a pending request, or admin delete.
      allow delete: if isAdmin() || (
        isAuthenticated()
        && request.auth.uid == resource.data.userId
        && resource.data.status == 'pending'
      );
    }
    
    
    // --- Radio Station Health ---
    // [SECURITY] Station health should only be updated by Cloud Functions
    match /radio_station_health/{stationId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Functions admin SDK ONLY
    }
    
    // --- User Radio Data ---
    match /users/{userId}/radio_history/{stationId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    match /users/{userId}/radio_favorites/{stationId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }

    // --- DSP Points System ---
    
    // User Points — owner can update non-financial fields only
    // [SECURITY] Financial balance fields (totalPoints, availablePoints, lifetimeEarnings,
    // stagedPoints, trustScore, quarterlyPoints) MUST only be modified via Cloud Functions
    // admin SDK to prevent manipulation
    match /user_points/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) &&
        intOrDefault(request.resource.data, 'totalPoints', 0) == 0 &&
        intOrDefault(request.resource.data, 'availablePoints', 0) == 0 &&
        intOrDefault(request.resource.data, 'stagedPoints', 0) == 0 &&
        intOrDefault(request.resource.data, 'lifetimeEarnings', 0) == 0;
      allow update: if isAdmin() || (
        isAuthenticated() && isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'walletAddress', 'currentStreak', 'lastActivityDate', 'lastUpdated',
          'dailyMessageCount', 'dailyShareCount', 'dailyCommunitiesMessaged',
          'verifiedCount', 'familyConnectionCount', 'qrConnectionCount',
          'completedExplorationActions', 'lastCheckInDate'
        ])
      );
      allow delete: if isAdmin();
    }

    // Immutable, server-authored financial ledger.
    match /points_transactions/{transactionId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update, delete: if false; // Immutable ledger
    }

    // Referral Codes — anyone can read (to validate), owner creates
    match /referral_codes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        intOrDefault(request.resource.data, 'usedCount', 0) == 0;
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
        intOrDefault(request.resource.data, 'usedCount', 0) ==
          intOrDefault(resource.data, 'usedCount', 0) + 1;
      allow delete: if false;
    }

    // Peer Visits (used for peer visit milestones & cooldown tracking)
    match /peer_visits/{pairId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.hostUserId == request.auth.uid ||
        resource.data.visitorUserId == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.hostUserId == request.auth.uid ||
        request.resource.data.visitorUserId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // DDI Loan Applications — read for community transparency, writes via Cloud Functions
    match /ddi_loan_applications/{applicationId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed via submitDdiLoanApplication / castDdiLoanVote / resolveDdiLoanVoting Cloud Functions
    }

    // System Stats
    // [SECURITY] System stats (treasury, DSP supply) are ONLY writable by Cloud Functions
    // Public read for dsp_supply (landing page epoch card)
    match /system_stats/dsp_supply {
      allow read: if true;
      allow write: if false;
    }
    // Public read for treasury (landing page SAFT valuation)
    match /system_stats/treasury {
      allow read: if true;
      allow write: if false;
    }
    match /system_stats/app_version {
      allow read: if true;
      allow write: if false;
    }
    match /system_stats/{statId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Functions admin SDK ONLY
    }

    // --- Feedback ---
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- Bereavement Fund ---
    match /bereavement_memberships/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['pending_proxy', 'pending_payment', 'active'];
      allow update: if isAdmin() || (
        isAuthenticated() && (
          isOwner(userId) ||
          resource.data.get('proxyUserId', '') == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /bereavement_claims/{claimId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['submitted', 'pending'];
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid &&
        resource.data.status in ['submitted', 'pending']
      );
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status in ['submitted', 'pending'];
    }

    // --- Emergency Fund ---
    match /emergency_fund_memberships/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isAuthenticated() && (
          isOwner(userId) ||
          resource.data.get('proxyUserId', '') == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /emergency_fund_claims/{claimId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['submitted', 'pending'];
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid &&
        resource.data.status in ['submitted', 'pending']
      );
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status in ['submitted', 'pending'];
    }

    // Proxy requests: sender creates, proxy reads & responds
    match /proxy_requests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId != request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        (
          resource.data.toUserId == request.auth.uid &&
          request.resource.data.fromUserId == resource.data.fromUserId &&
          request.resource.data.toUserId == resource.data.toUserId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'respondedAt', 'updatedAt'
          ])
        ) || (
          resource.data.fromUserId == request.auth.uid &&
          request.resource.data.fromUserId == request.auth.uid &&
          request.resource.data.toUserId != request.auth.uid
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        isAdmin()
      );
    }

    // Emergency Fund Stakers — users can read all (for count), write their own
    match /emergency_fund_stakers/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Emergency Fund Ledger — public read for transparency, server-only write
    match /emergency_fund_ledger/{entryId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Functions only
    }

    // Emergency Fund Interest List — public read for transparency,
    // user can create/delete their own entry.
    match /emergency_fund_interest/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isOwner(userId);
    }

    // Trust scores are derived by trusted server code only.
    match /trust_scores/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Stripe Customers — users can read their own, writes via Cloud Functions
    match /stripe_customers/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false; // Cloud Functions only
    }

    // --- Trust & Verification ---
    match /trust_ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId != request.auth.uid &&
        ratingId == request.auth.uid + '_' + request.resource.data.toUserId &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.toUserId)) &&
        request.resource.data.keys().hasOnly([
          'fromUserId', 'toUserId', 'score', 'isFullTrust',
          'stakedAmount', 'remainingStake', 'timestamp', 'fromUserName'
        ]) &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 100 &&
        request.resource.data.isFullTrust == (request.resource.data.score > 90) &&
        intOrDefault(request.resource.data, 'stakedAmount', 0) == 0 &&
        intOrDefault(request.resource.data, 'remainingStake', 0) == 0;
      allow update: if isAuthenticated() &&
        resource.data.fromUserId == request.auth.uid &&
        request.resource.data.fromUserId == resource.data.fromUserId &&
        request.resource.data.toUserId == resource.data.toUserId &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 100 &&
        request.resource.data.isFullTrust == (request.resource.data.score > 90) &&
        intOrDefault(request.resource.data, 'stakedAmount', 0) == intOrDefault(resource.data, 'stakedAmount', 0) &&
        intOrDefault(request.resource.data, 'remainingStake', 0) == intOrDefault(resource.data, 'remainingStake', 0) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'score', 'isFullTrust', 'timestamp', 'fromUserName', 'stakedAmount', 'remainingStake'
        ]);
      allow delete: if false;
    }

    match /payment_checkout_locks/{userId} {
      allow read, write: if false;
    }

    match /stripe_processed_payments/{paymentId} {
      allow read, write: if false;
    }

    match /field_verifications/{verificationId} {
      // Any authenticated user can read field verifications so profile views
      // can compute verifiedFields / flaggedFields for displayed profiles.
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId != request.auth.uid &&
        verificationId == request.auth.uid + '_' + request.resource.data.toUserId &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.toUserId)) &&
        request.resource.data.keys().hasOnly([
          'fromUserId', 'toUserId', 'fields', 'timestamp'
        ]) &&
        request.resource.data.fields is map &&
        request.resource.data.fields.size() > 0 &&
        request.resource.data.fields.size() <= 20;
      allow delete: if isAdmin();
    }

    match /vouches/{vouchId} {
       allow read: if isAuthenticated();
       allow create, update: if isAuthenticated() &&
         request.resource.data.fromUserId == request.auth.uid &&
         request.resource.data.toUserId != request.auth.uid &&
         vouchId == request.auth.uid + '_' + request.resource.data.toUserId &&
         exists(/databases/$(database)/documents/users/$(request.resource.data.toUserId)) &&
         request.resource.data.keys().hasOnly([
           'id', 'fromUserId', 'toUserId', 'relationship',
           'stakeAmount', 'createdAt'
         ]) &&
         request.resource.data.id == vouchId &&
         request.resource.data.relationship is string &&
         request.resource.data.relationship.size() > 0 &&
         request.resource.data.relationship.size() <= 100 &&
         intOrDefault(request.resource.data, 'stakeAmount', 0) == 0;
       allow delete: if isAdmin();
    }

    match /trust_data/{userId} {
       allow read: if isAuthenticated();
       allow create, update: if isAuthenticated() && (
         isOwner(userId) ||
         isAdmin() ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'verifiedFieldsCount', 'flaggedFieldsCount', 'majorBreaches', 'updatedAt'
         ])
       );
       allow delete: if isAdmin();
    }

    match /interest_registrations/{registrationId} {
      allow read, write: if isAuthenticated() && registrationId.matches('^' + request.auth.uid + '_.*');
    }

    // --- Governance ---
    // [SECURITY] The Global Fund Reserve is excluded from community governance.
    // No one — including authenticated users — may create, update, vote on,
    // or otherwise alter its governance unit. The on-chain wallet is owner-
    // controlled off-chain.
    match /governance/global_community {
      allow read: if false;
      allow write: if false;
    }

    // [SECURITY] Governance units for non-global communities
    match /governance/{unitId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && unitId != 'global_community';
      allow delete: if isAdmin();
    }

    match /governance_votes/{voteId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.voterId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Governance Election History
    match /governance_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin(); // Immutable election records
    }

    // --- Trust & Verification (Additional Collections) ---
    match /qr_exchanges/{exchangeId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    match /qr_handshake_challenges/{challengeId} {
      allow read, write: if false;
    }

    match /event_checkin_challenges/{challengeId} {
      allow read, write: if false;
    }

    match /check_ins/{checkInId} {
      allow read: if isAuthenticated() &&
        (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- Verified Solutions ---
    match /verified_solutions/{solutionId} {
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if false; // Immutable verification records
    }

    // --- Organization Vettings ---
    match /organization_vettings/{vettingId} {
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if false; // Immutable vetting records
    }

    // --- Secrets Collection (Wallets) ---
    match /communities/{communityId}/secrets/{secretId} {
       allow read: if isOrgAdmin(communityId) || isAdmin();
       allow write: if false; 
    }

    match /users/{userId}/secrets/{secretId} {
       allow read: if isOwner(userId) || isAdmin();
       allow write: if false; 
    }
    
    match /system_stats/{statId}/secrets/{secretId} {
       allow read: if isAdmin();
       allow write: if false;
    }

    // --- Marketplace ---
    match /marketplace_listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.sellerId == request.auth.uid &&
        intOrDefault(request.resource.data, 'viewCount', 0) == 0 &&
        intOrDefault(request.resource.data, 'savedCount', 0) == 0;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.sellerId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['viewCount', 'savedCount', 'reportCount', 'sellerId'])
        )
      );
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());

      // saved_by subcollection
      match /saved_by/{userId} {
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          get(/databases/$(database)/documents/marketplace_listings/$(listingId)).data.sellerId == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }

      match /views/{userId} {
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          get(/databases/$(database)/documents/marketplace_listings/$(listingId)).data.sellerId == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }

      // Contact intent marker — owner of the interaction can create/read their own marker.
      match /interactions/{userId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAdmin();
      }

      // reports subcollection
      match /reports/{reporterId} {
        allow read: if isAdmin() || (isAuthenticated() && isOwner(reporterId));
        allow create, update, delete: if false;
      }
    }

    // --- GDP Transactions ---
    match /gdp_transactions/{transactionId} {
      allow read: if isAuthenticated() &&
        (resource.data.actorUid == request.auth.uid || isAdmin());
      allow create: if false;
      allow update, delete: if false; // Immutable ledger
    }

    // --- Corridors ---
    match /corridors/{corridorId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions update GDP
    }

    // --- Hosting ---
    // Server creates requests from canonical profile/community data. Clients may
    // only express their own interest or cancel an unmatched request.
    match /hosting_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if isAuthenticated() && (
        (
          resource.data.travelerId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt'
          ])
        ) || (
          resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'interestedHostIds', 'updatedAt'
          ]) &&
          listOrEmpty(request.resource.data, 'interestedHostIds').size() <= 500 &&
          onlySelfListChange(
            listOrEmpty(resource.data, 'interestedHostIds'),
            listOrEmpty(request.resource.data, 'interestedHostIds')
          )
        )
      );
      allow delete: if isAuthenticated() &&
        resource.data.travelerId == request.auth.uid &&
        resource.data.status in ['pending', 'cancelled', 'expired'] &&
        !exists(/databases/$(database)/documents/hosting_sessions/$(requestId));
    }

    // Hosting lifecycle is server-authoritative and requires mutual consent.
    match /hosting_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.hostId == request.auth.uid ||
        resource.data.travelerId == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /hosting_checkin_challenges/{challengeId} {
      allow read, write: if false;
    }

    // --- P2P Stays & Car Rentals ---
    match /peer_listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        intOrDefault(request.resource.data, 'viewCount', 0) == 0 &&
        intOrDefault(request.resource.data, 'savedCount', 0) == 0;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.ownerId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['viewCount', 'savedCount', 'ownerId'])
        )
      );
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());

      // saved_by subcollection
      match /saved_by/{userId} {
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          get(/databases/$(database)/documents/peer_listings/$(listingId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }

      match /views/{userId} {
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          get(/databases/$(database)/documents/peer_listings/$(listingId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }
    }

    match /peer_bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.guestId == request.auth.uid ||
        resource.data.hostId == request.auth.uid || isAdmin()
      );
      allow create, update: if false;
      allow delete: if false;
    }

    match /peer_booking_slots/{slotId} {
      allow read, write: if false;
    }

    // --- Real Estate Listings ---
    match /real_estate_listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        intOrDefault(request.resource.data, 'viewCount', 0) == 0 &&
        intOrDefault(request.resource.data, 'savedCount', 0) == 0;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.ownerId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['viewCount', 'savedCount', 'ownerId'])
        )
      );
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());

      // View tracking subcollection (owner can read all views to display country stats)
      match /views/{viewId} {
        allow read: if isAuthenticated() && (
          isOwner(viewId) ||
          get(/databases/$(database)/documents/real_estate_listings/$(listingId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }

      // saved_by subcollection
      match /saved_by/{userId} {
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          get(/databases/$(database)/documents/real_estate_listings/$(listingId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }
    }

    match /event_attendance_history/{historyId} {
      allow read, write: if false;
    }

    // --- Flight Bookings ---
    match /flight_bookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if false;
      allow delete: if false;
    }

    // --- App Testers (PWA tester signup) ---
    match /app_testers/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create, update: if isAuthenticated() && isOwner(userId) &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // --- Landing Page Tester Signups (unauthenticated) ---
    // [SECURITY] Create-only, no read/update/delete from client.
    // Field validation prevents abuse — only expected fields are allowed.
    match /tester_signups/{signupId} {
      allow read, write: if false;
    }

    // --- Liquidity Treasury Interest Registrations (unauthenticated) ---
    // [SECURITY] Create-only, no read/update/delete from client.
    // Users on the landing page can register interest for TGE notifications.
    match /liquidity_interest/{interestId} {
      allow read, write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
