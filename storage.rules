rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
  
    // Helper function to check for images
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isSmallEnough() {
      return request.resource.size < 25 * 1024 * 1024; // 25MB
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        'admin' in request.auth.token && request.auth.token.admin == true;
    }
    // Null-safe helpers (in CEL, map.get(key, default) returns null if key is present with value null!)
    function listOrEmpty(data, key) {
      return data.get(key, []) is list ? data.get(key, []) : [];
    }
    function stringOrDefault(data, key, defaultVal) {
      return data.get(key, defaultVal) is string ? data.get(key, defaultVal) : defaultVal;
    }
    function boolOrDefault(data, key, defaultVal) {
      return data.get(key, defaultVal) is bool ? data.get(key, defaultVal) : defaultVal;
    }
    // Cross-service checks against Firestore (mirrors isChatParticipant /
    // chamber post-gating in firestore.rules) with cross-service IAM role enabled.
    function chatDoc(chatId) {
      return /databases/(default)/documents/chats/$(chatId);
    }
    function userChatDoc(chatId) {
      return /databases/(default)/documents/users/$(request.auth.uid)/userChats/$(chatId);
    }
    function isChamberChat(chatId) {
      return firestore.exists(chatDoc(chatId)) &&
        stringOrDefault(firestore.get(chatDoc(chatId)).data, 'subtype', '') == 'corridor_chamber';
    }
    function isChamberMember(chatId) {
      return isSignedIn() &&
        firestore.exists(userChatDoc(chatId)) &&
        stringOrDefault(firestore.get(userChatDoc(chatId)).data, 'accessLevel', '') == 'member';
    }
    function isChatParticipant(chatId) {
      return isSignedIn() && chatId.size() > 0 && (
        firestore.exists(userChatDoc(chatId)) ||
        (
          firestore.exists(chatDoc(chatId)) && (
            request.auth.uid in listOrEmpty(firestore.get(chatDoc(chatId)).data, 'participants') ||
            stringOrDefault(firestore.get(chatDoc(chatId)).data, 'type', '') == 'community' ||
            boolOrDefault(firestore.get(chatDoc(chatId)).data, 'isPublic', false) == true
          )
        )
      );
    }
    function canPostChatMedia(chatId) {
      return isChatParticipant(chatId) && (!isChamberChat(chatId) || isChamberMember(chatId));
    }
    function isEventOwner(eventId) {
      return isSignedIn() && eventId.size() > 0 &&
        firestore.exists(/databases/(default)/documents/events/$(eventId)) && (
          stringOrDefault(firestore.get(/databases/(default)/documents/events/$(eventId)).data, 'creatorId', '') == request.auth.uid ||
          stringOrDefault(firestore.get(/databases/(default)/documents/events/$(eventId)).data, 'createdBy', '') == request.auth.uid
        );
    }

    // --- Profile Photos & Business Logos ---
    // Path: profile_photos/{userId}/...
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      // Owner can upload images (≤25MB) or delete their own photos
      allow write: if request.auth != null && request.auth.uid == userId
                   && (request.resource == null || (isImage() && isSmallEnough()));
    }

    // --- Event Images ---
    // Path: event_images/{eventId} (or similar)
    // Authenticated users can upload event images or delete them.
    match /event_images/{eventId} {
      allow read: if true;
      allow write: if (isEventOwner(eventId) || isAdmin())
                   && (request.resource == null || (isImage() && isSmallEnough()));
    }

    // --- Chat/Group Media ---
    // Path: groups/{chatId}/... or chat_media/...
    match /groups/{chatId}/{allPaths=**} {
      allow read: if isChatParticipant(chatId) || isAdmin();
      allow write: if (canPostChatMedia(chatId) || isAdmin()) &&
        (request.resource == null || (isImage() && isSmallEnough()));
    }
    
    match /chat_media/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // [NEW] Explicit rules for folders used by ChatMessagingService
    match /chat_images/{chatId}/{allPaths=**} {
      allow read: if isChatParticipant(chatId) || isAdmin();
      allow write: if (canPostChatMedia(chatId) || isAdmin()) &&
        (request.resource == null || (isImage() && isSmallEnough()));
    }

    match /chat_videos/{chatId}/{allPaths=**} {
      allow read: if isChatParticipant(chatId) || isAdmin();
      allow write: if (canPostChatMedia(chatId) || isAdmin()) &&
        (request.resource == null || (
          request.resource.contentType.matches('video/.*') &&
          request.resource.size < 100 * 1024 * 1024
        ));
    }

    match /chat_voices/{chatId}/{allPaths=**} {
      allow read: if isChatParticipant(chatId) || isAdmin();
      allow write: if (canPostChatMedia(chatId) || isAdmin()) &&
        (request.resource == null || (
          request.resource.contentType.matches('audio/.*') &&
          request.resource.size < 25 * 1024 * 1024
        ));
    }

    match /chat_documents/{chatId}/{allPaths=**} {
      allow read: if isChatParticipant(chatId) || isAdmin();
      allow write: if (canPostChatMedia(chatId) || isAdmin()) &&
        (request.resource == null || (
          !request.resource.contentType.matches('text/html') &&
          !request.resource.contentType.matches('image/svg\\+xml') &&
          request.resource.size < 50 * 1024 * 1024
        ));
    }

    // --- Marketplace Listing Images ---
    // Path: marketplace/{userId}/...
    match /marketplace/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (request.resource == null || (isImage() && isSmallEnough()));
    }

    // --- Travel Listing Images (Hotels, Stays, Cars) ---
    // Path: hotels/{userId}/...
    match /hotels/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (request.resource == null || (isImage() && isSmallEnough()));
    }

    // Path: stays/{userId}/...
    match /stays/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (request.resource == null || (isImage() && isSmallEnough()));
    }

    // Path: cars/{userId}/...
    match /cars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (request.resource == null || (isImage() && isSmallEnough()));
    }

    // --- Real Estate Listing Images ---
    // Path: real_estate/{userId}/...
    match /real_estate/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (request.resource == null || (isImage() && isSmallEnough()));
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
