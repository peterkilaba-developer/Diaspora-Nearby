# Hardhat/Blockchain Environment Variables

# [REQUIRED] Deployment Private Key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# [REQUIRED] Basescan API Key for contract verification
BASESCAN_API_KEY=your_basescan_api_key_here

# [OPTIONAL] Override default addresses (defaults to deployer)
# ADMIN_ADDRESS=0x...
# UPGRADER_ADDRESS=0x...

# [OPTIONAL] Staging Vaults
# FOUNDERS_VAULT=0x...
# INVESTORS_VAULT=0x...

# [ORACLE] Firebase Oracle Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
ENGINE_ADDRESS=0x...
TGE_ADDRESS=0x...
